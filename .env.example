# Copie para .env na raiz do projeto e preencha antes de rodar `docker compose up -d --build`.
# Este arquivo e lido automaticamente pelo docker-compose.yml (nao precisa de --env-file).

# URLs publicas (dominios de teste - trocar para os definitivos quando sair do teste)
NEXT_PUBLIC_API_URL=https://apitrilva.viniciusgnandt.com.br

# dono do repositorio no GitHub (usado para montar ghcr.io/<owner>/trilva-*) - so
# importa se voce for usar `docker compose pull` com as imagens buildadas pelo CI
GHCR_OWNER=viniciusgnandt

# MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/trilva

# Auth
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-em-producao

# Tenant usado pelos scripts de manutencao (npm run backfill:*, criar:usuario-tenant-existente)
DEFAULT_TENANT_ID=000000000000000000000001

# DJEN - Diario de Justica Eletronico Nacional (API publica do CNJ)
DJEN_API_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# DataJud (API publica do CNJ, requer chave)
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=

# OCI Object Storage (compativel com S3) - armazenamento de documentos por processo
OCI_NAMESPACE=
OCI_BUCKET_NAME=JurisFlow
OCI_REGION=
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
