{
  "name": "trilva-backend",
  "version": "0.1.0",
  "description": "Trilva API - monitoramento de publicacoes e gestao de escritorios de advocacia",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "test": "jest",
    "seed:publicacoes:dje": "ts-node -r tsconfig-paths/register src/scripts/pull-publicacoes.script.ts",
    "backfill:processos": "ts-node -r tsconfig-paths/register src/scripts/backfill-processos.script.ts",
    "backfill:partes": "ts-node -r tsconfig-paths/register src/scripts/backfill-partes.script.ts",
    "backfill:clientes": "ts-node -r tsconfig-paths/register src/scripts/backfill-clientes.script.ts",
    "backfill:provisorios": "ts-node -r tsconfig-paths/register src/scripts/backfill-provisorios.script.ts",
    "backfill:audiencias": "ts-node -r tsconfig-paths/register src/scripts/backfill-audiencias.script.ts",
    "normalizar:classes": "ts-node -r tsconfig-paths/register src/scripts/normalizar-classes.script.ts",
    "criar:usuario-tenant-existente": "ts-node -r tsconfig-paths/register src/scripts/criar-usuario-tenant-existente.script.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.629.0",
    "@aws-sdk/s3-request-presigner": "^3.629.0",
    "@nestjs/axios": "^3.1.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongoose": "^8.6.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
