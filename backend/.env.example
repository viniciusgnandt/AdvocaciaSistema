PORT=3001
MONGO_URI=mongodb://localhost:27017/jurisflow

# DJEN - Diario de Justica Eletronico Nacional (API publica do CNJ / "Comunica")
# Documentacao: https://comunica.pje.jus.br/ (portal) - endpoint publico usado pela propria interface web
DJEN_API_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# DataJud - API publica do CNJ com metadados completos do processo (classe, assuntos,
# valor da causa, movimentacoes). Chave publica gratuita:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_API_KEY=

# Tenant usado pelo script de linha de comando (pull manual) enquanto nao ha login
DEFAULT_TENANT_ID=000000000000000000000001

# Auth - gere um valor aleatorio novo em producao (ex.: openssl rand -hex 48)
JWT_SECRET=troque-este-valor-em-producao

# OCI Object Storage (API compativel com S3) - armazenamento de documentos por processo
OCI_NAMESPACE=
OCI_BUCKET_NAME=JurisFlow
OCI_REGION=sa-saopaulo-1
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
